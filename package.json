{
  "name": "careergraph-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "CareerGraph AI — autonomous AI job search platform with graph memory (pnpm + Turborepo monorepo)",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @careergraph/api dev",
    "dev:web": "pnpm --filter @careergraph/web dev",
    "dev:worker": "pnpm --filter @careergraph/worker dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\" --ignore-path .prettierignore",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @careergraph/db db:generate",
    "db:migrate": "pnpm --filter @careergraph/db db:migrate",
    "db:deploy": "pnpm --filter @careergraph/db db:deploy",
    "db:reset": "pnpm --filter @careergraph/db db:reset",
    "db:seed": "pnpm --filter @careergraph/db db:seed",
    "db:studio": "pnpm --filter @careergraph/db db:studio",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
