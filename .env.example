# CareerGraph AI Environment Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001/api/v1

# FalkorDB Graph Database
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH_ID=careergraph
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# Relational Database & Queues
DATABASE_URL="file:./dev.db" # In production: postgresql://careergraph:password@localhost:5432/careergraph_db
REDIS_URL="redis://127.0.0.1:6379"

# Security & JWT
JWT_SECRET=careergraph-secret-jwt-key-2026-falkordb-hacks
JWT_EXPIRES_IN=7d

# LLM Configuration (mock | gemini | openai | anthropic)
LLM_PROVIDER=mock
# LLM_API_KEY=

# Job Providers
REMOTIVE_ENABLED=true
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Email Integrations
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
