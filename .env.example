# Environment Configuration — CareerGraph AI

NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001/api/v1
WEB_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://careergraph:@localhost:5432/careergraph"
DATABASE_TEST_URL="postgresql://careergraph:@localhost:5432/careergraph_test"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Tokens
JWT_ACCESS_SECRET="careergraph-access-secret-32-chars-minimum-safe"
JWT_REFRESH_SECRET="careergraph-refresh-secret-32-chars-minimum-safe"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
COOKIE_SECRET="careergraph-cookie-signing-secret-key-32-chars"

# Email Delivery (Default: Local Mailpit)
EMAIL_PROVIDER="mailpit" # mailpit | resend | smtp
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CareerGraph AI <notifications@codingspark.in>"

# Resend API (Optional for production)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CareerGraph AI <verify@codingspark.in>"

# AI Layer — OpenAI-compatible provider (QuickRouter AI recommended)
# QuickRouter: https://api.quickrouter.ai (models: gpt-6-astra:stable, gpt-6-luna)
# Also supports: OpenAI, Groq, Together, OpenRouter, NVIDIA NIM, local vLLM/Ollama
AI_PROVIDER="quickrouter"
AI_BASE_URL="https://api.quickrouter.ai/v1"
AI_API_KEY=""
AI_MODEL="gpt-6-astra:stable"
AI_ENABLED="false"
AI_TEMPERATURE="0.4"
AI_MAX_TOKENS="2048"
